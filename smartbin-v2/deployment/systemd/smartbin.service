[Unit]
Description=SmartBin AI v2 Industrial Waste Segregation Service
After=network.target multi-user.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/smartbin-v2
Environment="PYTHONUNBUFFERED=1"
Environment="DISPLAY=:0"
ExecStart=/home/pi/smartbin-v2/.venv/bin/python -m smartbin_v2.deployment.run_daemon
Restart=always
RestartSec=5s
KillMode=process
TimeoutSec=15
WatchdogSec=20s

# Security Hardening
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
