     class_agnostic = args.class_agnostic or cfg.model.class_agnostic
 
+    # Running with generic (COCO) weights but WITHOUT class-agnostic mode
+    # means every single detection gets dropped by the allowed_classes
+    # filter in detector.py (COCO labels never match the 7 waste classes),
+    # so the pipeline silently produces zero decisions. Auto-enable
+    # class-agnostic mode in that case so --allow-generic-model actually
+    # does something useful out of the box.
+    if args.allow_generic_model and not class_agnostic:
+        logger.warning(
+            "--allow-generic-model was set without --class-agnostic — "
+            "auto-enabling class-agnostic mode so detections aren't silently "
+            "dropped by the waste-class allowlist. Pass --class-agnostic "
+            "explicitly to silence this warning."
+        )
+        class_agnostic = True
+
